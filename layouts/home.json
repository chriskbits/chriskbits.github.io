{{- $items := slice -}}
{{- range where site.RegularPages "Section" "in" (slice "blog" "wissen") -}}
  {{- $items = $items | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" (cond (eq .Section "blog") "Blog" "Wissen")
      "tags" (.Params.tags | default slice)
      "summary" (.Summary | plainify | truncate 200)
      "content" (.Plain | truncate 5000)
  ) -}}
{{- end -}}
{{- with site.GetPage "/einzeiler" -}}
  {{- $text := slice -}}
  {{- range hugo.Data.einzeiler -}}{{- range .befehle -}}
    {{- $text = $text | append .titel .beschreibung .code -}}
  {{- end -}}{{- end -}}
  {{- $items = $items | append (dict
      "title" .Title
      "url" .RelPermalink
      "section" "Einzeiler"
      "tags" (slice "powershell")
      "summary" (.Summary | plainify | truncate 200)
      "content" (delimit $text " " | markdownify | plainify)
  ) -}}
{{- end -}}
{{- $items | jsonify -}}
